# systemd unit template — NeoKey reference sync server (phase 5, week 27)
# Copy to /etc/systemd/system/neokey-sync-server.service, put the real PKCS12
# path and password into /etc/neokey/sync.env (root-only, mode 600), then:
#   systemctl daemon-reload && systemctl enable --now neokey-sync-server
# Verify the READY line and pin:
#   journalctl -u neokey-sync-server -n 1   -> SYNC_SERVER_READY port=... spki=...
#   java -jar /opt/neokey/neokey-sync-server.jar --check https://127.0.0.1:8443/v1/ \
#        --pin <printed-spki> --anchor /etc/neokey/server-cert.pem

[Unit]
Description=NeoKey reference sync server (contract docs/SYNC-REST.md)
After=network.target

[Service]
Type=simple
EnvironmentFile=/etc/neokey/sync.env
ExecStart=/usr/bin/java -jar /opt/neokey/neokey-sync-server.jar \
  --keystore ${NK_KEYSTORE} --password ${NK_KEYPASS} --port 8443
# Fail-closed boot: no READY line = the unit is failed (Restart=on-failure).
Restart=on-failure
RestartSec=5
# Minimal exposure: loopback by default; public binding is an explicit
# operator decision (ExecStart --host 0.0.0.0 behind a TLS-terminating proxy).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/log/neokey

[Install]
WantedBy=multi-user.target
