+        snapA.entitlements.putAll(storeA.ownedPins());
+        snapA.dictWords.put("مفتاحية", "ar");
+        snapA.settings.put("haptics", "on");
+        long t0 = System.nanoTime();
+        List<SyncVault.Rec> stateA = SyncState.collect(snapA, 1, 5000L);
