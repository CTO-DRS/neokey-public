+        tagIs(r, 0, CommunityDict.T_EMPTY_WORD, "empty-word-tag");
+
+        // HAS_TASHKEEL_IN_WORD
+        r = CommunityDict.review(csv(row("كِتاب", "كِتَاب", "كِتَاب", G, "x", "amina", L)), INSTALLED);
+        tagIs(r, 0, CommunityDict.T_TASHKEEL, "tashkeel-in-word-tag");
