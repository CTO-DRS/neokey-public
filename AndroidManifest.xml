<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.hark.neokey"
    android:versionCode="3"
    android:versionName="0.3.0">

    <!-- W130: targetSdk 36 (Android 16) — Google Play requires API 36+ for app
         updates since 2026-08-31; minSdk 21 unchanged (device-reach policy). -->
    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="36" />
    <!-- week 32 (phase 6 W3): the duplicate VIBRATE declaration (lines 8+11, a
         latent defect since week 1) is REMOVED — the upload-bundle data-safety
         derivation refuses duplicates (safety.duplicate): one permission, one
         answer, and the console form would double-count it. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <package android:name="com.google.ar.lens" />
        <intent>
            <action android:name="com.google.zxing.client.android.SCAN" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_neo"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:supportsRtl="true"
        android:allowBackup="false">
        <!-- G1 (NEOKEY 1.0 GLOBAL — إصلاح P1): كانت allowBackup غائبة → الافتراضي
             منصّة = true، فمدخلات المستخدم (حافظة clips.db، كلمات التعلّم adapt_store،
             المسودة draft_text) مؤهلة لنسخ السحابة الآلية للجهاز. لوحة مفاتيح
             خصوصيتها ميزة = نسخ احتياطي منصّة مغلق؛ البديل المقصود هو النسخ اليدوي
             المشفّر نفسه (BackupActivity) الذي يستثني المفتاح ai_key أصلاً. -->

        <activity android:name=".SetupActivity" android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ClipEditActivity" android:exported="false"
            android:label="تعديل النص"
            android:theme="@style/FloatEditor"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".WriterActivity" android:exported="false"
            android:label="مساعد المراسلات"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".DictActivity" android:exported="false"
            android:label="قاموسي الشخصي"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".ClipIOActivity" android:exported="false"
            android:label="تصدير واستيراد الحافظة"
            android:taskAffinity=""
            android:excludeFromRecents="true" />
        <activity android:name=".BackupActivity" android:exported="false"
            android:label="النسخ الاحتياطي" />
        <activity android:name=".SyncActivity" android:exported="false"
            android:label="الحساب والمزامنة"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".PerfActivity" android:exported="false"
            android:label="مركز قياس الأداء"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".StoreActivity" android:exported="false"
            android:label="متجر السمات"
            android:windowSoftInputMode="adjustResize" />

        <service android:name=".NeoKeyService"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>
        <!-- W128: optional bank alert — off until the user allows it in Accessibility settings;
             reads only which app came to the front, never window content. -->
        <service android:name=".BankWatch"
            android:label="تنبيه البنوك من NeoKey"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/bank_watch" />
        </service>
    </application>
</manifest>
