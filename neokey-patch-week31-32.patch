++fail() { echo "SIGNEDAPKGATE_FAILED $1"; exit 1; }
++
++find_jar() {
++  for d in "${NEOKEY_TOOLS:-}" ./tools /workspace/work; do
++    [ -n "$d" ] && [ -f "$d/$1" ] && { echo "$d/$1"; return 0; }
++  done
++  return 1
++}
