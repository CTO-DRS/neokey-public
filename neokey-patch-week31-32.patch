++ANCHOR=$(keytool -list -v -keystore tests/ks/drill-release.p12 -storepass "$DP" \
++  -alias neokey-drill 2>/dev/null | grep -oE '[0-9A-F]{2}(:[0-9A-F]{2}){31}' | head -1 | tr -d ':' | tr 'A-F' 'a-f')
