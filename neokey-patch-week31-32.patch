+
+    private static void pos_uiKeys_liveCoupling() throws Exception {
+        LinkedHashSet<String> keys = UploadBundle.uiKeys(repoText("assets/ui_en.txt"));
+        ok("pos.uiKeys.size", keys.size() > 800, "keys=" + keys.size());
+        int live = 0;
