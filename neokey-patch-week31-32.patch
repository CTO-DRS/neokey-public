index 0000000..3208290
--- /dev/null
+++ b/neokey-patch-week31-32.patch
@@ -0,0 +1,48144 @@
+diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
+index 2a4282a..fb7f7fc 100755
+--- a/.github/workflows/ci.yml
++++ b/.github/workflows/ci.yml
+@@ -23,10 +23,10 @@ jobs:
+           curl -fsSLo tools/sqlite-jdbc.jar https://repo1.maven.org/maven2/org/xerial/sqlite-jdbc/3.46.1.0/sqlite-jdbc-3.46.1.0.jar
+           curl -fsSLo tools/slf4j-api.jar  https://repo1.maven.org/maven2/org/slf4j/slf4j-api/1.7.36/slf4j-api-1.7.36.jar
+ 
+-      - name: Install ripgrep (the secrets audit and the probe require it — week 31 fix: the audit was silently green without it)
++      - name: Install ripgrep (the secrets audit and the probe require it — week 31 fix — the audit was silently green without it)
+         run: sudo apt-get update -qq && sudo apt-get install -y -qq ripgrep
+ 
+-      - name: Pipeline gates — JVM-only mode (audit + tests + perf budgets; week 31 fix: SKIP_BUILD=1 — this job has no SDK pieces, the hosted ANDROID_SDK_ROOT made stage_build run and fail red since week 29)
++      - name: Pipeline gates — JVM-only mode (audit + tests + perf budgets; week 31 fix — SKIP_BUILD=1 — this job has no SDK pieces, the hosted ANDROID_SDK_ROOT made stage_build run and fail red since week 29)
+         run: SKIP_BUILD=1 ci/pipeline.sh
+ 
+       - name: Upload pipeline log
+@@ -43,16 +43,16 @@ jobs:
+       - uses: actions/setup-java@v4
+         with: { distribution: temurin, java-version: '17' }
+ 
+-      - uses: android-actions/setup-android@v3
+-
+       - name: Install SDK pieces expected by the build scripts
+         run: |
+-          sdkmanager --install "platforms;android-35" "platforms;android-30" "build-tools;35.0.0" > /dev/null
++          SDK="${ANDROID_SDK_ROOT:-$ANDROID_HOME}"
++          yes | "$SDK/cmdline-tools/latest/bin/sdkmanager" --licenses > /dev/null 2>&1 || true
++          "$SDK/cmdline-tools/latest/bin/sdkmanager" --install "platforms;android-35" "platforms;android-30" "build-tools;35.0.0" > /dev/null
+           SDK="${ANDROID_SDK_ROOT:-$ANDROID_HOME}"
+           ln -sfn "$SDK/platforms/android-35" "$SDK/android-35"
+           ln -sfn "$SDK/platforms/android-30" "$SDK/android-30"
+ 
+-      - name: Unsigned compile gate (week 31: green again — the W22 trim had dropped the identity strings, every aapt2 link since failed)
++      - name: Unsigned compile gate (week 31 — green again, the W22 trim had dropped the identity strings, every aapt2 link since failed)
+         run: ci/build_unsigned.sh
+ 
+       - name: R8 Full Mode shrink gate (roadmap item C — real-R via aapt2 on this machine)
+diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
+index 877f65a..cf52f63 100755
+--- a/.github/workflows/release.yml
++++ b/.github/workflows/release.yml
+@@ -44,8 +44,7 @@ jobs:
+       - uses: actions/checkout@v4
+       - uses: actions/setup-java@v4
+         with: { distribution: temurin, java-version: '17' }
+-      - uses: android-actions/setup-android@v3
+-      - name: Signing-secrets presence check (week 31: absent secrets = a DOCUMENTED skip, not a red run — the owner signs with the proven two-command path, docs/PHASE6-W2-REPORT.md)
++      - name: Signing-secrets presence check (week 31 — absent secrets = a DOCUMENTED skip, not a red run — the owner signs with the proven two-command path, docs/PHASE6-W2-REPORT.md)
+         id: sec
+         env:
+           KEYSTORE_B64: ${{ secrets.ANDROID_KEYSTORE_B64 }}
+@@ -55,7 +54,9 @@ jobs:
+                echo "RELEASE_SIGNING_SKIPPED — signing secrets not configured on this repo; the owner restores them (W28 procedure) and runs the two release commands (ci/build_signedapk.sh + SignedApk sign)"; fi
+       - name: Install SDK pieces
+         run: |
+-          sdkmanager --install "platforms;android-35" "platforms;android-30" "build-tools;35.0.0" > /dev/null
++          SDK="${ANDROID_SDK_ROOT:-$ANDROID_HOME}"
