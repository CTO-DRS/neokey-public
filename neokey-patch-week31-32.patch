++#            v1=1 v2=1 vc=72 vn=2.5 apk_sha256=… dex=…/512000
++#            / SIGNEDAPKGATE_FAILED <reason> (exit 1)
++set -uo pipefail
++cd "$(dirname "$0")/.."
++
