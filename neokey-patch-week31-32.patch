++AAPT2=""
++for d in "${NEOKEY_TOOLS:-}" ./tools /workspace/work; do
++  [ -n "$d" ] && [ -x "$d/aapt2" ] && { AAPT2="$d/aapt2"; break; }
++done
++[ -n "$AAPT2" ] || fail "badging (aapt2 missing)"
++BADGE=$("$AAPT2" dump badging build/NeoKey-2036.apk | head -1)
