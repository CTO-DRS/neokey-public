++java -cp "$OUT:$CP" com.hark.neokey.SignedApk sign \
++  build/sapk/aligned.apk build/NeoKey-2036.apk \
++  tests/ks/drill-release.p12 drill-pass-2026 neokey-drill "$EXPECTED_FP" || fail "sign"
