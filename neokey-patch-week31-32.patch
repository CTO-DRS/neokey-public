+        System.out.println();
+        String apkSha = UploadBundle.sha256Hex(UploadBundle.member(bundle, UploadBundle.MEMBERS[0]));
+        System.out.println("UPLOADBUNDLEGATE_OK checks=" + CHECKS + " negatives=" + NEG_OK + "/" + NEG_TOTAL
