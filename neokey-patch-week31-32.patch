+                s = s.replaceFirst("\"versionCode\": [0-9]+", "\"versionCode\": 9999");
+                Files.write(new File(dir, "statement.json").toPath(), s.getBytes(StandardCharsets.UTF_8));
+            } else if (wantTag.equals("statement.schema")) {
